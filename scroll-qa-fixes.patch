+
+/* --------------------------------------------------------------------------
+   Visual QA stabilization
+   Keeps the scroll storytelling, but removes inherited layout collisions and
+   shortens the journey so it feels cinematic rather than laborious.
+   -------------------------------------------------------------------------- */
+
+.scroll-story-theme .hero {
+  min-height: 118svh;
+}
+
+.scroll-story-theme .scroll-manifesto {
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: auto auto;
+  min-height: 80svh;
+  justify-items: center;
+}
+
+.scroll-story-theme .scroll-manifesto > span {
+  display: none;
+}
+
+.scroll-story-theme .scroll-manifesto p {
+  width: auto;
+  max-width: 100%;
+  text-align: center;
+}
+
+/* Restore the intended lower gradient and use the original number badge.
+   The earlier scroll rule had accidentally converted this full-card overlay
+   into a second number, which also created duplicate labels on mobile. */
+.scroll-story-theme .scroll-archive .example-card::after {
+  top: auto;
+  right: 0;
+  bottom: 0;
+  left: 0;
+  width: auto;
+  height: 44%;
+  color: transparent;
+  content: "";
+  background: linear-gradient(transparent, rgba(7, 23, 34, 0.86));
+}
+
+.scroll-story-theme .scroll-archive .example-card-paper::after {
+  background: linear-gradient(transparent, rgba(248, 244, 235, 0.97));
+}
+
+.scroll-story-theme .scroll-archive .example-card-sand::after {
+  background: linear-gradient(transparent, rgba(217, 195, 156, 0.96));
+}
+
+.scroll-story-theme .scroll-archive .example-card-paper > strong,
+.scroll-story-theme .scroll-archive .example-card-paper > small,
+.scroll-story-theme .scroll-archive .example-card-sand > strong,
+.scroll-story-theme .scroll-archive .example-card-sand > small {
+  color: var(--scroll-ink);
+}
+
+.scroll-story-theme .scroll-archive .example-card-paper .example-number,
+.scroll-story-theme .scroll-archive .example-card-sand .example-number {
+  border-color: rgba(7, 21, 31, 0.26);
+  background: rgba(248, 244, 235, 0.66);
+  color: var(--scroll-ink);
+}
+
+.scroll-story-theme .scroll-closing {
+  min-height: 98svh;
+}
+
+@media (min-width: 981px) {
+  .scroll-story-theme .scroll-archive {
+    min-height: 280svh;
+  }
+
+  .scroll-story-theme .scroll-archive .section-heading {
+    top: 78px;
+    grid-template-columns: minmax(0, 0.9fr) minmax(280px, 0.38fr);
+    gap: clamp(36px, 6vw, 88px);
+    align-items: start;
+    padding-top: clamp(42px, 5.6vh, 66px);
+    padding-bottom: 24px;
+    background: linear-gradient(#07151f 0 82%, rgba(7, 21, 31, 0));
+  }
+
+  .scroll-story-theme .scroll-archive .section-heading h2 {
+    max-width: 790px;
+    font-size: clamp(3.4rem, 5.8vw, 6.35rem);
+    line-height: 0.86;
+  }
+
+  .scroll-story-theme .scroll-archive .section-heading > p {
+    max-width: 360px;
+    margin-top: clamp(34px, 6vh, 70px);
+  }
+
+  .scroll-story-theme .scroll-archive .example-grid {
+    padding-top: clamp(360px, 42vh, 430px);
+    padding-bottom: clamp(36px, 6vh, 72px);
+  }
+
+  .scroll-story-theme .scroll-editions {
+    min-height: 230svh;
+  }
+
+  .scroll-story-theme .scroll-editions .product-grid {
+    width: min(790px, 56vw);
+    margin-top: -72px;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(190px, 230px);
+    grid-template-rows: auto auto auto auto minmax(0, 1fr);
+    gap: 16px clamp(30px, 4vw, 54px);
+    align-content: start;
+    align-items: start;
+    min-height: min(72vh, 700px);
+    padding: clamp(38px, 5vw, 68px);
+  }
+
+  .scroll-story-theme .scroll-editions .product-card::before {
+    display: none;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card-top {
+    grid-column: 1 / -1;
+    align-self: start;
+    margin-bottom: 8px;
+  }
+
+  .scroll-story-theme .scroll-editions .product-kicker,
+  .scroll-story-theme .scroll-editions .product-card > h3,
+  .scroll-story-theme .scroll-editions .product-card > p:not(.product-kicker),
+  .scroll-story-theme .scroll-editions .product-card > ul {
+    grid-column: 1;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > h3 {
+    max-width: 620px;
+    margin: 4px 0 0;
+    font-size: clamp(3.25rem, 5.15vw, 5.7rem);
+    line-height: 0.86;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > p:not(.product-kicker) {
+    max-width: 520px;
+    margin: 0;
+    font-size: 0.98rem;
+    line-height: 1.65;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > ul {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 9px 20px;
+    max-width: 610px;
+    margin-top: 6px;
+  }
+
+  .scroll-story-theme .scroll-editions .product-select-button {
+    grid-column: 2;
+    grid-row: 2 / -1;
+    align-self: end;
+    justify-self: stretch;
+    width: 100%;
+    margin: 0 0 12px;
+  }
+
+  .scroll-story-theme .scroll-process {
+    min-height: 220svh;
+  }
+
+  .scroll-story-theme .scroll-process .section-heading {
+    display: block;
+    width: min(570px, 42vw);
+    padding-top: clamp(76px, 10vh, 118px);
+  }
+
+  .scroll-story-theme .scroll-process .section-heading h2 {
+    max-width: 570px;
+    font-size: clamp(3.35rem, 5.75vw, 6.15rem);
+    line-height: 0.88;
+  }
+
+  .scroll-story-theme .scroll-process .steps {
+    top: 37vh;
+    width: min(610px, 43vw);
+  }
+
+  .scroll-story-theme .scroll-process .steps > li {
+    display: grid;
+    grid-template-columns: 86px minmax(0, 1fr);
+    gap: clamp(24px, 3vw, 42px);
+    align-items: start;
+    min-height: 245px;
+    padding: 30px 0;
+  }
+
+  .scroll-story-theme .scroll-process .steps > li::before {
+    display: none;
+  }
+
+  .scroll-story-theme .scroll-process .steps > li > span {
+    grid-column: 1;
+    align-self: start;
+  }
+
+  .scroll-story-theme .scroll-process .steps > li > div {
+    display: block;
+    grid-column: 2;
+  }
+
+  .scroll-story-theme .scroll-process .steps h3 {
+    max-width: 430px;
+    margin: 0 0 14px;
+    font-size: clamp(2.5rem, 4vw, 4.25rem);
+    line-height: 0.9;
+  }
+
+  .scroll-story-theme .scroll-process .steps p {
+    max-width: 410px;
+    margin: 0;
+    line-height: 1.65;
+  }
+}
+
+@media (max-width: 980px) {
+  .scroll-story-theme .scroll-manifesto {
+    grid-template-columns: minmax(0, 1fr);
+    grid-template-rows: auto auto;
+    justify-items: center;
+  }
+
+  .scroll-story-theme .scroll-manifesto p {
+    width: 100%;
+    text-align: center;
+    white-space: nowrap;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 16px;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card::before {
+    display: none;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > * {
+    grid-column: 1;
+    grid-row: auto;
+  }
+
+  .scroll-story-theme .scroll-editions .product-select-button {
+    width: 100%;
+    margin-top: 10px;
+  }
+
+  .scroll-story-theme .scroll-process .section-heading {
+    display: block;
+  }
+
+  .scroll-story-theme .scroll-process .steps > li {
+    display: grid;
+    grid-template-columns: 54px minmax(0, 1fr);
+    gap: 18px;
+  }
+
+  .scroll-story-theme .scroll-process .steps > li::before {
+    display: none;
+  }
+
+  .scroll-story-theme .scroll-process .steps > li > span {
+    grid-column: 1;
+    grid-row: auto;
+  }
+
+  .scroll-story-theme .scroll-process .steps > li > div {
+    display: block;
+    grid-column: 2;
+  }
+}
+
+@media (max-width: 640px) {
+  .scroll-story-theme .scroll-manifesto {
+    min-height: 58svh;
+    padding-block: 12vh;
+  }
+
+  .scroll-story-theme .scroll-manifesto p {
+    font-size: clamp(3.2rem, 17.4vw, 5.15rem);
+    line-height: 0.79;
+    letter-spacing: -0.065em;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > h3 {
+    font-size: clamp(2.45rem, 11vw, 3.8rem);
+    line-height: 0.92;
+  }
+
+  .scroll-story-theme .scroll-process .steps > li > span {
+    font-size: 3.7rem;
+  }
+
+  .scroll-story-theme .scroll-process .steps h3 {
+    font-size: clamp(2rem, 9vw, 3rem);
+  }
+}
+
+/* Product-card row reset: the original catalogue deliberately layered every
+   text element in one row. The stacked scroll plates need normal document flow. */
+.scroll-story-theme .scroll-editions .product-card-top,
+.scroll-story-theme .scroll-editions .product-card > .product-kicker,
+.scroll-story-theme .scroll-editions .product-card > h3,
+.scroll-story-theme .scroll-editions .product-card > p:not(.product-kicker),
+.scroll-story-theme .scroll-editions .product-card > ul,
+.scroll-story-theme .scroll-editions .product-card > .product-select-button {
+  grid-row: auto;
+  align-self: start;
+}
+
+.scroll-story-theme .scroll-editions .product-card-top {
+  display: flex;
+  justify-content: space-between;
+  justify-items: normal;
+  align-content: normal;
+  align-items: flex-start;
+}
+
+@media (min-width: 981px) {
+  .scroll-story-theme .scroll-archive .example-card {
+    height: clamp(390px, 50vh, 560px);
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > .product-kicker {
+    margin: 0;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > h3,
+  .scroll-story-theme .scroll-editions .product-card > p:not(.product-kicker),
+  .scroll-story-theme .scroll-editions .product-card > ul {
+    align-self: start;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > ul {
+    margin: 8px 0 0;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > .product-select-button {
+    grid-row: 2 / -1;
+    align-self: end;
+  }
+}
+
+@media (max-width: 980px) {
+  .scroll-story-theme .scroll-editions .product-card-top,
+  .scroll-story-theme .scroll-editions .product-card > .product-kicker,
+  .scroll-story-theme .scroll-editions .product-card > h3,
+  .scroll-story-theme .scroll-editions .product-card > p:not(.product-kicker),
+  .scroll-story-theme .scroll-editions .product-card > ul,
+  .scroll-story-theme .scroll-editions .product-card > .product-select-button {
+    grid-column: 1;
+    grid-row: auto;
+    align-self: start;
+  }
+
+  .scroll-story-theme .scroll-editions .product-card > .product-select-button {
+    justify-self: stretch;
+  }
+}
+
+@media (max-width: 980px) {
+  .scroll-story-theme .scroll-manifesto p:first-child,
+  .scroll-story-theme .scroll-manifesto p:last-child {
+    transform: none;
+  }
+
+  .scroll-story-theme .scroll-process .section-heading {
+    padding-top: 0;
+  }
+}
